{
  "appId": "com.recumend.app",
  "appName": "Recumend",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#08090C"
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#08090C",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  }
}